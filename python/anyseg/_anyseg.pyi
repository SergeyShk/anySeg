from collections.abc import Iterator, Sequence
from typing import Literal, Self, final, overload

__all__ = [
    "Document",
    "Line",
    "Lines",
    "Paragraph",
    "Paragraphs",
    "Segmenter",
    "Sentence",
    "Sentences",
    "Span",
    "Token",
    "Tokens",
    "Word",
    "Words",
    "__version__",
    "read_conllu",
]
__version__: str

@final
class Span:
    def __new__(cls, start: int, end: int, text: str) -> Self: ...
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def text(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Segmenter:
    def __new__(cls, lang: str) -> Self: ...
    @property
    def lang(self) -> str: ...
    def tokenize(self, text: str) -> list[Span]: ...
    def sentenize(self, text: str) -> list[Span]: ...
    def segment(self, text: str) -> Document: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Document:
    @property
    def text(self) -> str: ...
    @property
    def tokens(self) -> Tokens: ...
    @property
    def words(self) -> Words: ...
    @property
    def sentences(self) -> Sentences: ...
    @property
    def paragraphs(self) -> Paragraphs: ...
    @property
    def lines(self) -> Lines: ...
    @overload
    def column(self, name: Literal["head"]) -> list[int | None]: ...
    @overload
    def column(self, name: Literal["form"]) -> list[str]: ...
    @overload
    def column(
        self, name: Literal["lemma", "upos", "xpos", "feats", "deprel", "deps", "misc"]
    ) -> list[str | None]: ...
    def set_columns(
        self,
        *,
        lemma: Sequence[str | None] = ...,
        upos: Sequence[str | None] = ...,
        xpos: Sequence[str | None] = ...,
        feats: Sequence[str | None] = ...,
        head: Sequence[int | None] = ...,
        deprel: Sequence[str | None] = ...,
        deps: Sequence[str | None] = ...,
        misc: Sequence[str | None] = ...,
    ) -> None: ...
    @staticmethod
    def from_tokens(
        text: str,
        starts: Sequence[int],
        ends: Sequence[int],
        *,
        sentence_starts: Sequence[int] | None = None,
    ) -> Document: ...
    def to_conllu(self, *, doc_id: str | None = None) -> str: ...

