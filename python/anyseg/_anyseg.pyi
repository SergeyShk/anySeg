    @property
    def form(self) -> str: ...
    @property
    def lemma(self) -> str | None: ...
    @property
    def upos(self) -> str | None: ...
    @property
    def xpos(self) -> str | None: ...
    @property
    def feats(self) -> str | None: ...
    @property
    def head(self) -> int | None: ...
    @property
